<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="#1B1724"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/tvMarcaModelo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Yamaha MT-03"
        android:textColor="#F4F0FF"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCilindraje"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Cilindraje: 321 cc"
        android:textColor="#B9AECF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvPrecioStock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Precio: $145,000.0 | Stock: 3"
        android:textColor="#9B5CFF"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnEditarMoto"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:backgroundTint="#4A1C85"
            android:text="Editar"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btnEliminarMoto"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:backgroundTint="#2E154A"
            android:text="Eliminar"
            android:textAllCaps="false"
            android:textColor="#F4F0FF"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>